{
  "env": [
    {
      "CYCLES_ROOT": {
        "value": "@CMAKE_INSTALL_PREFIX@/houdini",
        "method": "replace"
      }
    },
    {
      "CYCLES_ICON": {
        "value": "$CYCLES_ROOT/icons/blender.png",
        "method":"replace"
      }
    },
    {
      "PATH": {
        "value": "$CYCLES_ROOT/bin",
        "method": "append"
      }
    }
  ],
  "hpath": "$CYCLES_ROOT"
}